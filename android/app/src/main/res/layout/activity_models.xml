<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hv_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <Button
            android:id="@+id/m_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_ghost"
            android:paddingHorizontal="14dp"
            android:text="←"
            android:textColor="@color/hv_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            style="@style/TextVox.Title"
            android:text="Voice models" />
    </LinearLayout>

    <TextView
        android:id="@+id/m_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp"
        android:textColor="@color/hv_text_dim"
        android:textSize="14sp" />

    <!-- #114/#6: blocking header status. Incomplete required set = WARNING
         treatment ("setup required", warn color); complete = "Voice ready" in
         ok color. Text/color are set from ModelsActivity.updateHeaderStatus(). -->
    <TextView
        android:id="@+id/m_req_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="4dp"
        android:text="⚠ Setup required"
        android:textColor="@color/hv_warn"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- #120-D: one-line plain-language glossary, so the jargon (STT/VAD/TTS)
         on this screen and in Settings reads the same way everywhere. -->
    <TextView
        android:id="@+id/m_how"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="2dp"
        android:textColor="@color/hv_text_dim"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <Button
        android:id="@+id/m_download_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_primary"
        android:elevation="4dp"
        android:text="Install the required voice models"
        android:textColor="@color/hv_bg"
        android:textSize="16sp"
        android:textAllCaps="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/m_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- #219: advanced controls live here, collapsed. The source override
                 (and anything destructive) must never be the first thing seen,
                 but must stay reachable. Same row-into-panel reveal as Settings. -->
            <LinearLayout
                android:id="@+id/m_advanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Advanced — download source"
                    style="@style/HvRowTitle" />

                <TextView
                    android:id="@+id/m_adv_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="show ›"
                    style="@style/HvRowAction" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/m_adv_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Where new model files are fetched from. The default is the upstream release; leave it alone unless you mirror the models yourself."
                    android:textColor="@color/hv_text_dim"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/m_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="https://…"
                    android:inputType="textUri"
                    android:padding="14dp"
                    android:textColor="@color/hv_text"
                    android:textColorHint="@color/hv_text_dim"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/m_source_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/hv_text_dim"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Equal weights so the largest system font wraps each label
                         instead of pushing the pair off-screen. -->
                    <Button
                        android:id="@+id/m_source_save"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_primary"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:text="Save source"
                        android:textAllCaps="false"
                        android:textColor="@color/hv_bg" />

                    <Button
                        android:id="@+id/m_source_reset"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_button_ghost"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:text="Use default"
                        android:textAllCaps="false"
                        android:textColor="@color/hv_text" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Installed models are not affected by this address. Changing it only changes where a future download is fetched from."
                    android:textColor="@color/hv_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
