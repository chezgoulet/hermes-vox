<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mi_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            style="@style/TextVox.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mi_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="★ Recommended"
            style="@style/TextVox.Label"
            android:textColor="@color/hv_cyan" />
    </LinearLayout>

    <TextView
        android:id="@+id/mi_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="—"
        style="@style/TextVox.Label" />

    <TextView
        android:id="@+id/mi_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        style="@style/TextVox.Label" />

    <ProgressBar
        android:id="@+id/mi_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mi_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Not installed"
        style="@style/TextVox.Label" />

    <Button
        android:id="@+id/mi_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_primary"
        android:paddingHorizontal="18dp"
        android:text="Download"
        android:textColor="@color/hv_bg"
        android:textAllCaps="false" />
</LinearLayout>
