<?xml version="1.0" encoding="utf-8"?>
<!-- #219: one model row. Everything is a vertical stack so the largest system
     font can wrap the purpose, the size and the state instead of clipping them.
     Reading order on screen == reading order for a screen reader: name, what it
     does for you, size, state, licence, action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/mi_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        style="@style/TextVox.Body"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mi_recommended"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="★ Recommended"
        android:textColor="@color/hv_cyan"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 1. What it does for the user, in one plain sentence (never the
         catalogue's internal `desc`). -->
    <TextView
        android:id="@+id/mi_purpose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="—"
        android:textColor="@color/hv_text_dim"
        android:textSize="14sp" />

    <!-- 2. The true decimal-MB download size. -->
    <TextView
        android:id="@+id/mi_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="—"
        android:textColor="@color/hv_text_dim"
        android:textSize="13sp" />

    <!-- 3. The state, always as words (colour is only a hint). Live region so a
         transfer's changes are announced without moving focus. -->
    <TextView
        android:id="@+id/mi_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:lineSpacingExtra="2dp"
        android:text="Not installed"
        android:textColor="@color/hv_text_dim"
        android:textSize="14sp" />

    <!-- 4. The licence badge, shown only when the licence is not permissive. Its
         text says what tapping does; tapping opens the SAME acceptance dialog the
         Download button uses. -->
    <TextView
        android:id="@+id/mi_licence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textColor="@color/hv_cyan"
        android:textSize="13sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/mi_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/mi_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_primary"
        android:minHeight="48dp"
        android:paddingHorizontal="18dp"
        android:text="Download"
        android:textAllCaps="false"
        android:textColor="@color/hv_bg" />
</LinearLayout>
