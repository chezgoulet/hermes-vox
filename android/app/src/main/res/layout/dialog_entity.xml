<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <EditText
        android:id="@+id/d_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hv_url_hint"
        android:inputType="textUri"
        android:padding="12dp"
        android:textColor="@color/hv_text"
        android:textColorHint="@color/hv_text_dim"
        android:textSize="16sp" />

    <!-- T7: in Settings → Entity this is the host-given entity name, read-only. The
         profile editor in ProfileDialogs also inflates this layout and uses it for the
         profile's own model route, so the read-only state is set by Settings, not XML. -->
    <EditText
        android:id="@+id/d_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hv_model_hint"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="@color/hv_text"
        android:textColorHint="@color/hv_text_dim"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/d_entity_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="2dp"
        android:textColor="@color/hv_text_dim"
        android:textSize="12sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/d_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hv_key_hint"
        android:inputType="textPassword"
        android:padding="12dp"
        android:textColor="@color/hv_text"
        android:textColorHint="@color/hv_text_dim"
        android:textSize="16sp" />

    <!-- The scope is an identity, not a credential: it sits after the key so the
         connection block (endpoint · model · key) reads as one group. Optional —
         blank means the gateway's per-transcript default. -->
    <EditText
        android:id="@+id/d_scope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hv_scope_hint"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="@color/hv_text"
        android:textColorHint="@color/hv_text_dim"
        android:textSize="16sp" />
</LinearLayout>
