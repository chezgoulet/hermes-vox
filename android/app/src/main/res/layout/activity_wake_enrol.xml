<?xml version="1.0" encoding="utf-8"?>
<!-- #45: wake-word enrolment (preview). Records the owner's takes of the wake
     phrase, 15 s of free speech and 15 s of room sound, encrypted and device-local.
     Starts no background listening. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hv_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <Button
            android:id="@+id/wk_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_ghost"
            android:paddingHorizontal="14dp"
            android:text="←"
            android:textColor="@color/hv_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            style="@style/TextVox.Title"
            android:text="Wake word (preview)" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/wk_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/hv_text_dim"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

            <!-- Consent: shown until granted. Takes cannot be saved without it. -->
            <LinearLayout
                android:id="@+id/wk_consent_box"
                style="@style/HvRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/wk_consent_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hv_text"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />
                <Button
                    android:id="@+id/wk_consent"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="I agree — keep my recordings on this phone"
                    android:textColor="@color/hv_bg"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/wk_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/hv_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/wk_prompts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/wk_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/hv_text"
                android:textSize="18sp" />

            <!-- Why the long takes are needed; hidden for phrase takes. -->
            <TextView
                android:id="@+id/wk_why"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/hv_text_dim"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wk_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/hv_text_dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/wk_record"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:text="Record"
                android:textColor="@color/hv_bg"
                android:textSize="16sp" />

            <Button
                android:id="@+id/wk_delete"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_ghost"
                android:text="Delete all my recordings"
                android:textColor="@color/hv_text"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
