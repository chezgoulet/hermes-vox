<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hv_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextVox.Title"
                android:text="HERMES VOX" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextVox.Tag"
                android:text="@string/hv_tag" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextVox.Tag"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/hv_not_connected" />
    </LinearLayout>

    <!-- Avatar -->
    <com.hermesvox.AvatarView
        android:id="@+id/avatar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/avatar_size"
        android:layout_marginTop="8dp" />

    <!-- Reply card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_surface"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/reply"
                style="@style/TextVox.Reply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </FrameLayout>

    <!-- Stream console -->
    <TextView
        android:id="@+id/stream"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_log"
        android:padding="10dp"
        android:text="// stream log — watch the agent work"
        android:scrollbars="vertical"
        style="@style/TextVox.Console" />

    <!-- Input row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/hv_input_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:padding="12dp"
            android:textColor="@color/hv_text"
            android:textColorHint="@color/hv_text_dim"
            android:textSize="16sp" />

        <Button
            android:id="@+id/mic"
            android:layout_width="@dimen/mic_size"
            android:layout_height="@dimen/mic_size"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_mic"
            android:elevation="6dp"
            android:text="🎤"
            android:textColor="@color/hv_bg"
            android:textSize="24sp"
            android:contentDescription="Talk" />

        <Button
            android:id="@+id/send"
            android:layout_width="56dp"
            android:layout_height="@dimen/mic_size"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="4dp"
            android:text="@string/hv_send"
            android:textColor="@color/hv_bg"
            android:textSize="22sp"
            android:contentDescription="Send" />
    </LinearLayout>

    <!-- Secondary actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_ghost"
            android:paddingHorizontal="18dp"
            android:text="Settings"
            android:textColor="@color/hv_text"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/realtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_ghost"
            android:paddingHorizontal="18dp"
            android:text="Realtime"
            android:textColor="@color/hv_text"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_ghost"
            android:paddingHorizontal="18dp"
            android:text="Clear"
            android:textColor="@color/hv_text"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
