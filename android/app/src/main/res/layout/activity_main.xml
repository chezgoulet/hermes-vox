<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hv_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header: agent name (center-top) + status pill directly beneath -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
            android:id="@+id/agent_name"
            style="@style/TextVox.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="HERMES VOX" />
        <TextView
            android:id="@+id/status"
            style="@style/TextVox.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/hv_not_connected" />
    </LinearLayout>

    <!-- Presence hero (the being occupies the upper field) -->
    <com.hermesvox.AvatarView
        android:id="@+id/avatar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4"
        android:layout_marginTop="4dp" />

    <!-- Crawl area: reply (bright) + SSE (smaller, darker) over the black.
         Text drifts up + fades near the top, before touching the particle field. -->
    <FrameLayout
        android:id="@+id/crawl_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp">

        <com.hermesvox.CrawlView
            android:id="@+id/stream"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.hermesvox.CrawlView
            android:id="@+id/reply_crawl"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Conversation mode: a persistent, readable transcript (a11y). -->
        <ScrollView
            android:id="@+id/conversation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <TextView
                android:id="@+id/convo_text"
                style="@style/TextVox.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:padding="14dp"
                android:textColor="@color/hv_text" />
        </ScrollView>
    </FrameLayout>

    <!-- Input row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/hv_input_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="@color/hv_text"
            android:textColorHint="@color/hv_text_dim"
            android:textSize="16sp" />
        <Button
            android:id="@+id/mic"
            android:layout_width="72dp"
            android:layout_height="@dimen/mic_size"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_mic"
            android:elevation="6dp"
            android:gravity="center"
            android:text="PTT"
            android:textColor="@color/hv_bg"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:contentDescription="Push to talk" />
        <Button
            android:id="@+id/send"
            android:layout_width="56dp"
            android:layout_height="@dimen/mic_size"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="4dp"
            android:text="SEND"
            android:textColor="@color/hv_bg"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:contentDescription="Send text" />
    </LinearLayout>

    <!-- Secondary actions: gear (left) · realtime (center toggle) · commands (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button
            android:id="@+id/settings"
            style="@style/HvGhostButton"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_ghost"
            android:text="⚙"
            android:textColor="@color/hv_text"
            android:textSize="18sp"
            android:contentDescription="Settings" />
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <Button
            android:id="@+id/realtime"
            style="@style/HvGhostButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_ghost"
            android:paddingHorizontal="18dp"
            android:text="Realtime"
            android:textColor="@color/hv_text"
            android:textAllCaps="false"
            android:contentDescription="Realtime call" />
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <Button
            android:id="@+id/commands"
            style="@style/HvGhostButton"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_ghost"
            android:text="/"
            android:textColor="@color/hv_text"
            android:textSize="17sp"
            android:contentDescription="Commands" />
    </LinearLayout>
</LinearLayout>
