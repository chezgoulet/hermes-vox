<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hv_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Glowing orb -->
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_orb"
        android:contentDescription="Orb" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        style="@style/TextVox.Title"
        android:text="HERMES VOX" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextVox.Tag"
        android:text="@string/hv_tag" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        style="@style/TextVox.Body"
        android:text="@string/hv_sub"
        android:gravity="center" />

    <EditText
        android:id="@+id/url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_input"
        android:hint="@string/hv_url_hint"
        android:inputType="textUri"
        android:padding="14dp"
        android:textColor="@color/hv_text"
        android:textColorHint="@color/hv_text_dim"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="@string/hv_key_hint"
        android:inputType="textPassword"
        android:padding="14dp"
        android:textColor="@color/hv_text"
        android:textColorHint="@color/hv_text_dim"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="@string/hv_model_hint"
        android:inputType="text"
        android:padding="14dp"
        android:textColor="@color/hv_text"
        android:textColorHint="@color/hv_text_dim"
        android:textSize="16sp" />

    <Button
        android:id="@+id/connect"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_button_primary"
        android:elevation="4dp"
        android:text="@string/hv_connect_verify"
        android:textColor="@color/hv_bg"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        style="@style/TextVox.Label"
        android:text="@string/hv_skip" />
</LinearLayout>
