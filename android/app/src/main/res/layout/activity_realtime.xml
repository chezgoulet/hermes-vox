<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hv_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Immersive header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TextVox.Title"
            android:text="REALTIME" />
        <Button
            android:id="@+id/rt_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_ghost"
            android:paddingHorizontal="14dp"
            android:text="←"
            android:textColor="@color/hv_text"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Ambient notice (soft) -->
    <TextView
        android:id="@+id/rt_mode_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:visibility="gone"
        style="@style/TextVox.Tag"
        android:textColor="@color/hv_warn"
        android:text="voice unavailable — typing" />

    <!-- The being -->
    <com.hermesvox.AvatarView
        android:id="@+id/rt_avatar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp" />

    <!-- Reply: the same Star-Wars crawl as the Main (no boxes) -->
    <com.hermesvox.CrawlView
        android:id="@+id/rt_crawl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="90dp" />

    <!-- Input -->
    <LinearLayout
        android:id="@+id/rt_textmode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <EditText
            android:id="@+id/rt_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/hv_input_hint"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textColor="@color/hv_text"
            android:textColorHint="@color/hv_text_dim"
            android:textSize="16sp" />
        <Button
            android:id="@+id/rt_send"
            android:layout_width="56dp"
            android:layout_height="@dimen/mic_size"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="4dp"
            android:text="@string/hv_send"
            android:textColor="@color/hv_bg"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
