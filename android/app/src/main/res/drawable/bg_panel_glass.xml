<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft glass panel: translucent, rounded, faint top-light + hairline -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:centerColor="#0BFFFFFF"
                android:endColor="#06000000" />
            <stroke android:width="1dp" android:color="#1EFFFFFF" />
        </shape>
    </item>
</layer-list>
