<?xml version="1.0" encoding="utf-8"?>
<!-- Every AlertDialog's card (UI/UX pass): the app's surface, corner and hairline on its own
     ground, instead of AppCompat's stock Material card. The inset is the stock dialog's, so
     the card sits where a dialog is expected to. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetTop="16dp"
    android:insetRight="16dp"
    android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/hv_surface" />
        <corners android:radius="@dimen/corner_l" />
        <stroke android:width="1dp" android:color="@color/hv_border" />
    </shape>
</inset>
