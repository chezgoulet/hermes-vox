<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Hermes Vox type scale + dimensions. -->
    <dimen name="gap_xs">6dp</dimen>
    <dimen name="gap_s">10dp</dimen>
    <dimen name="gap_m">16dp</dimen>
    <dimen name="gap_l">24dp</dimen>
    <dimen name="gap_xl">40dp</dimen>
    <dimen name="corner_m">14dp</dimen>
    <dimen name="corner_l">22dp</dimen>
    <dimen name="corner_full">999dp</dimen>
    <dimen name="avatar_size">260dp</dimen>
    <dimen name="mic_size">66dp</dimen>

    <!-- Sci-fi display face (Rajdhani, OFL) for headings/labels/buttons; the
         crawl + console stay monospace (the "House terminal" voice). -->
    <style name="TextVox.Title" parent="android:Widget.TextView">
        <item name="android:textColor">@color/hv_text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="TextVox.Tag" parent="android:Widget.TextView">
        <item name="android:textColor">@color/hv_cyan</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextVox.Label" parent="android:Widget.TextView">
        <item name="android:textColor">@color/hv_text_dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/rajdhani_medium</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextVox.Body" parent="android:Widget.TextView">
        <item name="android:textColor">@color/hv_text</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextVox.Reply" parent="android:Widget.TextView">
        <item name="android:textColor">@color/hv_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="TextVox.Console" parent="android:Widget.TextView">
        <item name="android:textColor">@color/hv_cyan</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Ghost action buttons (Settings/Call/Clear) -->
    <style name="HvGhostButton" parent="android:Widget.Button">
        <item name="android:fontFamily">@font/rajdhani_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- UI/UX pass: every AlertDialog in the app (pickers, confirmations, the health and
         compress cards, the profile lists) on the app's own ground — its surface and corners
         (bg_dialog), the display face for the title, the accent for the choice and the
         buttons — instead of AppCompat's stock card. One theme, so no dialog can be missed. -->
    <style name="ThemeOverlay.HermesVox.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorAccent">@color/hv_cyan</item>
        <item name="colorControlActivated">@color/hv_cyan</item>
        <item name="colorControlNormal">@color/hv_text_dim</item>
        <item name="android:textColorPrimary">@color/hv_text</item>
        <item name="android:textColorSecondary">@color/hv_text_dim</item>
        <item name="android:textColorAlertDialogListItem">@color/hv_text</item>
        <item name="android:windowTitleStyle">@style/HvDialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/HvDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/HvDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/HvDialogButton</item>
    </style>
    <style name="HvDialogTitle" parent="RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:textAppearance">@style/HvDialogTitleText</item>
    </style>
    <style name="HvDialogTitleText" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/hv_text</item>
    </style>
    <style name="HvDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/hv_cyan</item>
        <item name="android:fontFamily">@font/rajdhani_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- #402: the Alpha panel's slide-out. -->
    <style name="HvSlideFromEnd">
        <item name="android:windowEnterAnimation">@anim/slide_in_end</item>
        <item name="android:windowExitAnimation">@anim/slide_out_end</item>
    </style>
</resources>
