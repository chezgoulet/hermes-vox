<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HvRow">
        <item name="android:background">@drawable/bg_surface</item>
        <!-- #224: rows carry a one-line hint under the title, so the title is often
             two or three lines. Baseline-aligning it with the row's help chip or
             switch pushes it past the padding box, where clipToPadding cuts the last
             line in half. Top-align instead: every child starts inside the padding. -->
        <item name="android:baselineAligned">false</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="HvRowTitle">
        <item name="android:textColor">@color/hv_text</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="HvRowValue">
        <item name="android:textColor">@color/hv_text_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
    <style name="HvRowAction">
        <item name="android:textColor">@color/hv_cyan</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
