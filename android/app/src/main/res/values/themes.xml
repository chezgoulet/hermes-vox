<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HermesVox" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- LIGHT variant of the sci-fi identity. Hero is dark. -->
        <item name="colorPrimary">@color/hv_cyan</item>
        <item name="colorAccent">@color/hv_violet</item>
        <item name="android:windowBackground">@color/hv_bg</item>
        <item name="android:colorBackground">@color/hv_bg</item>
        <item name="android:textColor">@color/hv_text</item>
        <item name="android:statusBarColor">@color/hv_bg</item>
        <item name="android:navigationBarColor">@color/hv_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- #329: the assist gesture is fired by the system, sometimes from the lock screen.
         The bridge must be invisible: no window, no dim, no animation. -->
    <style name="Theme.HermesVox.Assist" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
