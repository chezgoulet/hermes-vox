<?xml version="1.0" encoding="utf-8"?>
<!-- Hermes Vox is local-first: the entity endpoint is YOUR gateway on your own
     network. Every host requires TLS except tailnet MagicDNS names (below), whose
     traffic is already encrypted by the tailnet itself. There are no per-host
     exceptions: a gateway on a bare LAN IP should be put behind HTTPS.
     Note: model downloads already go over HTTPS (huggingface.co) and are covered
     by the base-config. If a host is ever publicly reachable, serve it over TLS.

     Self-hosters: rather than rebuilding the APK for a cleartext IP, prefer
     `tailscale serve` on the gateway host and enter the HTTPS endpoint
     (https://<machine>.<tailnet>.ts.net). The user trust anchor below lets you
     trust the tailnet CA (Settings → Security → Trust device certificates) so
     TLS verification passes on your own tailnet — no app rebuild, no cleartext. -->
<network-security-config>
    <!-- Default: everything not explicitly listed must be HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <!-- NEW: user-installed CAs (e.g. the tailnet root cert) are trusted
                 for entity endpoints. Lets tailscale-serve HTTPS work without
                 weakening cleartext policy. -->
            <certificates src="user"/>
        </trust-anchors>
    </base-config>

    <!-- NEW: any tailnet MagicDNS name may be reached in cleartext ONLY as a
         fallback; with tailscale serve the https:// form is preferred.
         (MagicDNS names are tailnet-private by construction — this cannot leak
         to the public internet.) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
