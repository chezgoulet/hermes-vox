<?xml version="1.0" encoding="utf-8"?>
<!-- Hermes Vox is local-first: the entity endpoint is YOUR gateway on your own
     network. Every host requires TLS except tailnet MagicDNS names (below), whose
     traffic is encrypted by the tailnet itself. There are no per-host exceptions:
     a gateway on a bare LAN IP should be put behind HTTPS.
     Note: model downloads already go over HTTPS (huggingface.co) and are covered
     by the base-config. If a host is ever publicly reachable, serve it over TLS.

     Self-hosters: rather than rebuilding the APK for a cleartext IP, prefer
     `tailscale serve` on the gateway host and enter the HTTPS endpoint
     (https://<machine>.<tailnet>.ts.net). The ts.net domain-config below lets you
     trust the tailnet CA (Settings → Security → Trust device certificates) so
     TLS verification passes on your own tailnet — no app rebuild, no cleartext.

     M4 (0.9.1 review): the user trust anchor is scoped to ts.net, NOT the base
     config. Trusting a user-installed CA for every host lets any such CA (a work
     proxy, a test root, a hostile profile) mint a certificate for the gateway and
     read the bearer key. The anchor exists for the tailnet CA and belongs there.
     A LAN gateway with a self-signed certificate is therefore not trusted any
     more; use a certificate the system store trusts, or tailscale serve. A
     cleartext LAN gateway was never permitted (base cleartext=false), and the app
     additionally refuses http:// off-loopback whenever the tunnel is down
     (`core/CleartextPolicy.kt`). -->
<network-security-config>
    <!-- Default: everything not explicitly listed must be HTTPS, system CAs only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- The tailnet: MagicDNS names may be reached in cleartext (with tailscale
         serve the https:// form is preferred), and the tailnet's own CA may be
         trusted. The app still refuses cleartext here while Tailscale is down, so
         a hostile network cannot answer the name and collect the key. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </domain-config>
    <!-- Permit user CAs exclusively in debug builds for local testing/mocking.
         In release builds, this block is automatically ignored by the Android platform. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" overridePins="true"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
