<?xml version="1.0" encoding="utf-8"?>
<!-- Hermes Vox is local-first. Endpoints are private-network hosts, and TLS is
     required for every host except tailnet MagicDNS names, whose traffic the
     tailnet already encrypts. Model downloads use HTTPS and are covered by the
     base configuration.

     The user trust anchor is scoped to ts.net deliberately. Trusting a
     user-installed CA for every host would let a work proxy, a test root or a
     hostile profile mint a certificate for the gateway and read the bearer key.
     A LAN gateway with a self-signed certificate therefore needs a certificate
     the system store trusts, or tailscale serve; it is not covered here. The app
     also refuses cleartext off-loopback while the tunnel is down. -->
<network-security-config>
    <!-- Default: HTTPS only, system trust store. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- Tailnet MagicDNS may be cleartext as a fallback; tailscale serve is the
         preferred HTTPS path. The tailnet CA is trusted only inside this scope. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
