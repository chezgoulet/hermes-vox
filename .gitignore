# Local reference checkout; never track its source or nested submodules.
/third_party/apparat/

# Local Go build cache and tooling populated by the Makefile / build scripts.
/.tools/

# Host-local Agentic Pipelines configuration, dependencies, and execution evidence.
/.agentic-pipelines/
/api.yaml
/state/
/artifacts/
/threads/
/reports/
/releases/
/failures/
/runs/
*.rejected.md
*.rejected.json
*.rejected.txt
mobile.aar
mobile-sources.jar
models-store/
android/app/libs/sherpa-onnx-1.13.6.aar
keystore/*
!keystore/*.age

# Never commit build logs / build artifacts / local run output.
*.log
*.out
/artifacts/
/releases/
/runs/
*.iml
.evidence/

# Claude Code local state (agent worktrees)
.claude/

# sttbench: model cache + venv (hundreds of MB; fetched by run_bench.py --fetch)
/tools/sttbench/.models
/tools/sttbench/.venv

# compiled Python bytecode (never commit these)
__pycache__/
*.pyc

# sttbench-stream: generated corpus (mixed noise conditions), alignment cache and
# raw device results — all regenerable by scripts/stt-ab.sh.
/tools/sttbench-stream/corpus
/tools/sttbench-stream/.cache
# raw device results ARE committed (they are the evidence for docs/STT-AB.md);
# logs and the regenerated summary are not.
/tools/sttbench-stream/results/*.log

# Presence-bench host output (docs/PRESENCE-BENCH.md); the numbers live in the doc.
presence-bench-results/
# #165: the from-source sherpa-onnx build and its staged output.
android/.sherpa-build/
android/sherpa-src/
